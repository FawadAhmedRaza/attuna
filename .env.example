# Copy to .env (or .env.local) and fill in. Never commit real secrets.
# Production uses IAM roles + secrets manager — these vars are for local dev.

# ── AWS ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Cognito (separate pools for therapists and clients) ────────────
COGNITO_USER_POOL_ID_THERAPIST=
COGNITO_CLIENT_ID_THERAPIST=
COGNITO_USER_POOL_ID_CLIENT=
COGNITO_CLIENT_ID_CLIENT=

# ── Database (local Docker Postgres; see docker-compose.yml) ───────
DATABASE_URL=postgres://attuna:attuna@localhost:5432/attuna_dev
DATABASE_URL_TEST=postgres://attuna:attuna@localhost:5432/attuna_test
KMS_KEY_ID_PHI=

# ── Bedrock (Claude via AWS — NOT direct Anthropic API) ────────────
BEDROCK_MODEL_ID=anthropic.claude-opus-4-5

# ── App URLs ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Auth (dev stub session signing) ────────────────────────────────
# Required in production. In dev, a fallback is used if missing
# (a console warning is logged on first use).
# Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=

# ── Observability ──────────────────────────────────────────────────
SENTRY_DSN=

# ── Email (Postmark, BAA-covered) ──────────────────────────────────
POSTMARK_TOKEN=
EMAIL_FROM=hello@attuna.io
